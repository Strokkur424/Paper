Subject: [PATCH] paper File Patches


diff --git a/net/minecraft/server/jsonrpc/JsonRpcNotificationService.java b/net/minecraft/server/jsonrpc/JsonRpcNotificationService.java
index f897eb6075231b14032b723ad13af1db93fb2a5e..408786898bb2eabbb9ac0e9b927e0837457dce04 100644
--- a/net/minecraft/server/jsonrpc/JsonRpcNotificationService.java
+++ b/net/minecraft/server/jsonrpc/JsonRpcNotificationService.java
@@ -121,7 +121,8 @@ public class JsonRpcNotificationService implements NotificationService {
     }
 
     @Override
-    public <T> void onGameRuleChanged(final GameRule<T> gameRule, final T value) {
+    public <T> void onGameRuleChanged(net.minecraft.server.level.ServerLevel level, final GameRule<T> gameRule, final T value) { // Paper - per-world game rules (add level param)
+        if (level != level.getServer().overworld()) return; // Paper - per-world game rules - use overworld for vanilla protocol
         this.broadcastNotification(OutgoingRpcMethods.GAMERULE_CHANGED, GameRulesService.getTypedRule(this.minecraftApi, gameRule, value));
     }
 
