From f632b9eb8d5c757eaffb596f5fe062258ab24e42 Mon Sep 17 00:00:00 2001
From: File <noreply+automated@papermc.io>
Date: Sun, 20 Apr 1997 15:37:42 +0200
Subject: [PATCH] paper File Patches


diff --git a/net/minecraft/core/HolderSet.java b/net/minecraft/core/HolderSet.java
index 3fb93b8724ab9d9e7b388b80d9a8a1048f1e1cad..863f011a9d96dc059659ccd0c0cfc2c09a52ac56 100644
--- a/net/minecraft/core/HolderSet.java
+++ b/net/minecraft/core/HolderSet.java
@@ -164,6 +164,7 @@ public interface HolderSet<T> extends Iterable<Holder<T>> {
         private final HolderOwner<T> owner;
         private final TagKey<T> key;
         private @Nullable List<Holder<T>> contents;
+        private @Nullable Set<io.papermc.paper.registry.TypedKey<?>> typedKeys; // Paper - cache typed key set for constant contains calls
 
         Named(final HolderOwner<T> owner, final TagKey<T> key) {
             this.owner = owner;
@@ -172,6 +173,7 @@ public interface HolderSet<T> extends Iterable<Holder<T>> {
 
         void bind(final List<Holder<T>> contents) {
             this.contents = List.copyOf(contents);
+            this.typedKeys = null; // Paper - reset if tag is re-bound
         }
 
         public TagKey<T> key() {
@@ -216,5 +218,15 @@ public interface HolderSet<T> extends Iterable<Holder<T>> {
         public boolean canSerializeIn(final HolderOwner<T> context) {
             return context.canSerialize(this.owner);
         }
+
+        // Paper start - cache typed key set for constant contains calls
+        public boolean contains(io.papermc.paper.registry.TypedKey<?> key) {
+            if (this.typedKeys == null) {
+                this.typedKeys = this.contents().stream().map(h -> io.papermc.paper.registry.PaperRegistries.fromNms(h.unwrapKey().orElseThrow())).collect(java.util.stream.Collectors.toUnmodifiableSet());
+            }
+
+            return this.typedKeys.contains(key);
+        }
+        // Paper end - cache typed key set for constant contains calls
     }
 }
