                     ItemStack itemStack = this.getMainHandItem();
                     this.setItemSlot(EquipmentSlot.MAINHAND, ItemStack.EMPTY);
                     PotionContents potion = itemStack.get(DataComponents.POTION_CONTENTS);
+                    // Paper start - WitchConsumePotionEvent
