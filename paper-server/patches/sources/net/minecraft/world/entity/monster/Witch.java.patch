-                                this.getSoundSource(),
-                                1.0F,
-                                0.8F + this.random.nextFloat() * 0.4F
-                            );
-                    }
-
-                    AttributeInstance speed = this.getAttribute(Attributes.MOVEMENT_SPEED);
-                    speed.removeModifier(SPEED_MODIFIER_DRINKING_ID);
-                    speed.addTransientModifier(SPEED_MODIFIER_DRINKING);
