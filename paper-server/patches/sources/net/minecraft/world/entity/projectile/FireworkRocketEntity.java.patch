+    public java.util.@Nullable UUID spawningEntity; // Paper
 
     public FireworkRocketEntity(final EntityType<? extends FireworkRocketEntity> type, final Level level) {
         super(type, level);
@@ -163,7 +164,7 @@ public class FireworkRocketEntity extends Projectile implements ItemSupplier {
         }
 
         if (!this.noPhysics && this.isAlive() && hitResult.getType() != HitResult.Type.MISS) {
-            this.hitTargetOrDeflectSelf(hitResult);
+            this.preHitTargetOrDeflectSelf(hitResult); // CraftBukkit - projectile hit event
             this.needsSync = true;
         }
 
@@ -187,7 +188,11 @@ public class FireworkRocketEntity extends Projectile implements ItemSupplier {
         }
 
         if (this.life > this.lifetime && this.level() instanceof ServerLevel level) {
-            this.explode(level);
