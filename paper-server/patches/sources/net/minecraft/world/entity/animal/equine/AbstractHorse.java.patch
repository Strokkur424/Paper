@@ -896,6 +909,17 @@ public abstract class AbstractHorse extends Animal implements PlayerRideableJump
 
     @Override
     public void handleStartJump(final int jumpScale) {
+        // CraftBukkit start
+        float power;
+        if (jumpScale >= 90) {
+            power = 1.0F;
+        } else {
+            power = 0.4F + 0.4F * (float) jumpScale / 90.0F;
+        }
+        if (!org.bukkit.craftbukkit.event.CraftEventFactory.callHorseJumpEvent(this, power)) {
+            return;
+        }
+        // CraftBukkit end
         this.allowStandSliding = true;
         this.standIfPossible();
         this.playJumpSound();
