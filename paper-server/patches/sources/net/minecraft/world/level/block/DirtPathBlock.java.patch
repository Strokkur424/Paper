Subject: [PATCH] paper File Patches


diff --git a/net/minecraft/world/level/block/DirtPathBlock.java b/net/minecraft/world/level/block/DirtPathBlock.java
index 5f8e08c46396276b7c587fcd530ad21fc48cea18..bbc315a5e84164a391387182449a7bb8a5946efe 100644
--- a/net/minecraft/world/level/block/DirtPathBlock.java
+++ b/net/minecraft/world/level/block/DirtPathBlock.java
@@ -60,6 +60,11 @@ public class DirtPathBlock extends Block {
 
     @Override
     protected void tick(final BlockState state, final ServerLevel level, final BlockPos pos, final RandomSource random) {
+        // CraftBukkit start - do not fade if the block is valid here
+        if (state.canSurvive(level, pos)) {
+            return;
+        }
+        // CraftBukkit end
         FarmlandBlock.turnToDirt(null, state, level, pos);
     }
 
